                 g_print("Plate License %s\n", label_info->result_label);
               }
@@ -178,7 +222,64 @@ osd_sink_pad_buffer_probe(GstPad *pad, GstPadProbeInfo *info, gpointer u_data) {
           }
         }
       }
+      // exporter: one JSONL per object (vehicle=LPD parent link via parent id)
+      {
+        if (!g_tracks.is_open()) {
+          g_tracks.open(tracks_path(), std::ios::out | std::ios::trunc);
+        }
+          char plate_buf[128] = {0};
+          for (NvDsMetaList *lc = obj_meta->classifier_meta_list; lc;
+               lc = lc->next) {
+            NvDsClassifierMeta *cm = (NvDsClassifierMeta *)lc->data;
+            if (!cm || cm->unique_component_id != SECONDARY_CLASSIFIER_UID)
+              continue;
+            for (NvDsMetaList *ll = cm->label_info_list; ll; ll = ll->next) {
+              NvDsLabelInfo *li = (NvDsLabelInfo *)ll->data;
+              if (li && li->result_label[0]) {
+                snprintf(plate_buf, sizeof(plate_buf), "%s",
+                         li->result_label);
+                break;
+              }
+            }
+            if (plate_buf[0])
+              break;
+          }
+          guint64 parent_id = 0;
+          if (obj_meta->parent)
+            parent_id = ((NvDsObjectMeta *)obj_meta->parent)->object_id;
+          g_tracks << "{\"frame\":" << cur_frame << ",\"uid\":"
+                   << obj_meta->unique_component_id << ",\"cls\":"
