         if (obj_meta->class_id == PGIE_CLASS_ID_PERSON)
           person_count++;
       }
 
-      if (obj_meta->unique_component_id == SECONDARY_DETECTOR_UID) {
+      if (kept && obj_meta->unique_component_id == SECONDARY_DETECTOR_UID) {
         if (obj_meta->class_id == SGIE_CLASS_ID_LPD) {
