 #include <stdlib.h>
 #include <string.h>
 #include <cuda_runtime_api.h>
+#include <fstream>
+#include <string>
+
+// ponytail: minimal JSONL exporter, path via TRACKS_JSONL else /work/outputs/tracks.jsonl
+static std::ofstream g_tracks;
+static int g_exp_frame = 0; // frame_meta->frame_num no avanza aqui; como frame_number de la app
+static const char *tracks_path() {
+  const char *p = getenv("TRACKS_JSONL");
+  return p && *p ? p : "/work/outputs/tracks.jsonl";
+}
+
+// ROI 1280x720 (coords muxer): solo calzada hacia camara
+static float ROI_POLY[4][2] = {{20, 720}, {1280, 720}, {1050, 180}, {420, 180}};
+static int in_roi(float x, float y) {
+  int inside = 0, n = 4;
+  for (int i = 0, j = n - 1; i < n; j = i++) {
+    float xi = ROI_POLY[i][0], yi = ROI_POLY[i][1];
+    float xj = ROI_POLY[j][0], yj = ROI_POLY[j][1];
+    if ((yi > y) != (yj > y) &&
+        (x < (xj - xi) * (y - yi) / (yj - yi) + xi))
+      inside = !inside;
+  }
+  return inside;
+}
 
 #include "ds_yml_parse.h"
 #include "gst-nvmessage.h"
@@ -120,6 +144,9 @@ osd_sink_pad_buffer_probe(GstPad *pad, GstPadProbeInfo *info, gpointer u_data) {
