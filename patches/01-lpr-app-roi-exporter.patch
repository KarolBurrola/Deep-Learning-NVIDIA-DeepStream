+                   << obj_meta->rect_params.height << ",\"parent\":"
+                   << parent_id << ",\"plate\":\"" << plate_buf << "\",\"kept\":"
+                   << kept << "}\n";
+      }
+    }
+    // quitar del OSD lo fuera de ROI (y sus placas hijas, si las hubiera)
+    for (l_obj = frame_meta->obj_meta_list; l_obj != NULL;
+         l_obj = l_obj->next) {
+      NvDsObjectMeta *om = (NvDsObjectMeta *)l_obj->data;
+      if (om && om->unique_component_id == SECONDARY_DETECTOR_UID &&
+          om->parent) {
+        for (int k = 0; k < drop_n; k++) {
+          if (drop_list[k] == (NvDsObjectMeta *)om->parent) {
+            int dup = 0;
+            for (int j = 0; j < drop_n; j++)
+              if (drop_list[j] == om)
+                dup = 1;
+            if (!dup && drop_n < 512)
+              drop_list[drop_n++] = om;
+            break;
+          }
+        }
+      }
     }
+    for (int k = 0; k < drop_n; k++)
+      nvds_remove_obj_meta_from_frame(frame_meta, drop_list[k]);
 
     display_meta = nvds_acquire_display_meta_from_pool(batch_meta);
     NvOSD_TextParams *txt_params = &display_meta->text_params[0];
