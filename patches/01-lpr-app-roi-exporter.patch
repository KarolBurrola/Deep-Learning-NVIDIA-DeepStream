+                      obj_meta->class_id == PGIE_CLASS_ID_VEHICLE);
+        if (!in_roi(cx, cy) ||
+            (is_veh && (obj_meta->rect_params.width < 20 ||
+                         obj_meta->rect_params.height < 20))) {
+          kept = 0;
